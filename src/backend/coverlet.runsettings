<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <Format>cobertura</Format>
                    <ExcludeByAttribute>
                        Obsolete,
                        GeneratedCodeAttribute,
                        CompilerGeneratedAttribute
                    </ExcludeByAttribute>
                    <Exclude>
                        [*.Migrations.*]*
                    </Exclude>
                    <ExcludeByFile>
                        **/Migrations/*.cs,
                        **/Configurations/*.cs,
                        **/Program.cs,
                        **/Startup.cs,
                        **/*ServiceCollectionExtensions.cs,
                        **/*Spec.cs,
                        **/*OptionsSetup.cs
                    </ExcludeByFile>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>
